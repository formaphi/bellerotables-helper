#!/bin/sh
set -e

echo "---- Sandbox image ----"
make sandbox-build

echo "---- clang-format ----"
make format-check

echo "---- Release build ----"
make rebuild

echo "---- clang-tidy (uses the release compile_commands.json) ----"
make tidy-check

echo "---- Unit tests + gcov ----"
make rebuild-unit
make test-unit

echo "---- AddressSanitizer + UBSan ----"
make rebuild-asan
make test-asan

echo "---- Valgrind memcheck ----"
make rebuild-valgrind
make test-valgrind

echo "All checks passed."
